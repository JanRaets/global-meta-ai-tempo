# TEMPO configuration — every secret the app can use, as environment variable names.
# Preferred on a dev machine: dotnet user-secrets (project Tempo.Api) or the gitignored
# Tempo.Api/appsettings.local.json. Never commit a real value to this repo.

# Meta Model API (required — Muse Spark + Muse Voice Transcribe)
Models__MetaApi__ApiKey=

# Baseten (optional — Muse Spark Open fallback / open-weight primary)
Models__Baseten__ApiKey=
# Run the open-weight model as primary instead of fallback:
# Models__Primary=Baseten

# OpenRouteService (required — directions + geocoding; free key at openrouteservice.org)
Routing__ApiKey=

# Google Calendar OAuth (optional — read-only sync)
Google__ClientId=
Google__ClientSecret=

# Web Push VAPID key pair (required for push; generate once, see architecture.md)
Push__VapidPublicKey=
Push__VapidPrivateKey=

# Infrastructure (compose defaults shown)
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=tempo;Username=tempo;Password=tempo
ConnectionStrings__Redis=localhost:6380

# Safety valve for model spend (defaults to 200 agent runs/day)
# Agent__MaxRunsPerDay=200

# Note: the per-user location API key is not configured here — it is generated into the
# UserSettings row at first startup and rotated via the dev endpoint (architecture.md).
